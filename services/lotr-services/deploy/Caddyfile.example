# Generated-shape example of the lotr-services routes (validated and exercised end to end with Caddy v2.11.7
# against the service in enforce mode on 2026-10-15). Reference only: the real Caddyfile is generated by the
# site deploy scripts from templates\Caddyfile.template + lib\SiteDeploy.Services.ps1 (see DEPLOY.md).
{
	auto_https off
	admin off
}
:8099 {
	root * "C:/www/lotrmp/current"
	file_server
	handle_path /files/* {
		# Core download queue (lotr-services, mode advisory): objects need ?slot=<token> from /api/queue/slot.
		@releaseObjects path_regexp releaseobj ^/releases/[^/]+/objects/
		forward_auth @releaseObjects 127.0.0.1:3010 {
			uri /internal/queue/check
		}
		root * "C:/www/lotrmp/files"
		file_server browse
	}
	# Updater services (lotr-services on 127.0.0.1:3010, Install-Services.ps1).
	handle /api/queue/* {
		request_body {
			max_size 16KB
		}
		reverse_proxy 127.0.0.1:3010
	}
	handle /api/support {
		request_body {
			max_size 3MB
		}
		reverse_proxy 127.0.0.1:3010
	}
}
