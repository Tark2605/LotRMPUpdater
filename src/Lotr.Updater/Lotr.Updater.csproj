<Project Sdk="Microsoft.NET.Sdk">
  <!-- LotRMPUpdater.exe: the player-facing Windows app (WPF, .NET Framework 4.8 = present on every Windows 10/11).
       Single file: every referenced DLL is embedded as a resource and loaded from memory (Program.cs). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LotRMPUpdater</AssemblyName>
    <RootNamespace>Lotr.Updater</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <StartupObject>Lotr.Updater.Program</StartupObject>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lotr.Updater.Core\Lotr.Updater.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\app-256.png" />
    <Resource Include="Resources\Fonts\*.ttf" />
    <EmbeddedResource Include="Resources\Fonts\OFL.txt" LogicalName="licences.OFL.txt" />
  </ItemGroup>
  <!-- Embed every copy-local DLL (Core, GameDetection, ZstdSharp and its System.* helpers) so the exe runs alone. -->
  <Target Name="EmbedCopyLocalAssemblies" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'">
        <LogicalName>lib.%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
  <!-- A Release exe must carry the production release key: without it every release is refused (CONTRACTS §3).
       Paste <root>\data\secrets\release-signing.pub.pem into src/Lotr.Updater.Core/Security/Keys/ (docs/MANIFEST.md),
       or build with -p:AllowNoProductionKey=true for a test exe. -->
  <Target Name="CheckProductionKey" BeforeTargets="CoreCompile" Condition="'$(Configuration)' == 'Release' And '$(AllowNoProductionKey)' != 'true'">
    <ItemGroup>
      <_LotrProductionKey Include="..\Lotr.Updater.Core\Security\Keys\*.pub.pem" />
    </ItemGroup>
    <Error Condition="'@(_LotrProductionKey)' == ''" Code="LOTR001"
           Text="No production release key embedded: put release-signing.pub.pem in src\Lotr.Updater.Core\Security\Keys\ (see docs/MANIFEST.md, Production key), or build with -p:AllowNoProductionKey=true for a test exe that refuses every release." />
    <Error Condition="'$(LotrBaseUrl)' == ''" Code="LOTR002"
           Text="No production server: build with -p:LotrBaseUrl=https://&lt;your-domain&gt; (tools/Build-Updater.ps1 does it), or -p:AllowNoProductionKey=true for a test exe." />
  </Target>
</Project>
