<Window x:Class="Lotr.Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Lotr.Updater.ViewModels"
        Title="LOTR Event" Width="1060" Height="700" MinWidth="900" MinHeight="620"
        Background="{StaticResource Night}" WindowStartupLocation="CenterScreen"
        Icon="Resources/app.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource Parchment}">
    <Window.Resources>
        <vm:VisibleWhen x:Key="Vis"/>
        <vm:VisibleWhen x:Key="NotVis" Invert="True"/>
        <vm:PageIs x:Key="PageIs"/>

        <!-- coloured badge for an issue / verify row -->
        <DataTemplate x:Key="IssueTemplate">
            <Border x:Name="row" BorderThickness="2,0,0,0" BorderBrush="{StaticResource Gold}" Background="#0DC9A45C" Padding="12,8" Margin="0,0,0,6">
                <DockPanel>
                    <TextBlock x:Name="tag" DockPanel.Dock="Left" Width="86" Text="{Binding Severity}" FontFamily="{StaticResource DisplayFont}" FontSize="11" Foreground="{StaticResource Gold}" Margin="0,2,8,0"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{Binding LinkText}" Margin="12,0,0,0" VerticalAlignment="Top" Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding LinkUrl}" Visibility="{Binding HasLink, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" FontSize="13"/>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="blocker"><Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Rubric}"/><Setter TargetName="row" Property="Background" Value="#1AE0563A"/><Setter TargetName="tag" Property="Foreground" Value="{StaticResource Rubric}"/><Setter TargetName="tag" Property="Text" Value="must fix"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="warning"><Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Ember}"/><Setter TargetName="tag" Property="Foreground" Value="#E89A5C"/><Setter TargetName="tag" Property="Text" Value="note"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="missing"><Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Rubric}"/><Setter TargetName="tag" Property="Foreground" Value="{StaticResource Rubric}"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="different"><Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Ember}"/><Setter TargetName="tag" Property="Foreground" Value="#E89A5C"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="duplicate"><Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Ember}"/><Setter TargetName="tag" Property="Foreground" Value="#E89A5C"/></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="fixed"><Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Elven}"/><Setter TargetName="tag" Property="Foreground" Value="{StaticResource Elven}"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- one station of the road: a diamond on the line, its name and a short note -->
        <DataTemplate x:Key="StationTemplate">
            <StackPanel>
                <Grid Height="26">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Rectangle x:Name="left" Height="1.5" Fill="#3A3226" VerticalAlignment="Center" Visibility="{Binding ShowLeft, Converter={StaticResource Vis}}"/>
                    <Rectangle x:Name="right" Grid.Column="1" Height="1.5" Fill="#3A3226" VerticalAlignment="Center" Visibility="{Binding ShowRight, Converter={StaticResource Vis}}"/>
                    <Rectangle x:Name="gem" Grid.ColumnSpan="2" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Fill="{StaticResource Night}" Stroke="#5A4A30" StrokeThickness="1.2" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
                <TextBlock x:Name="label" Text="{Binding Label}" FontFamily="{StaticResource DisplayFont}" FontSize="12" Foreground="#6E6656" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock x:Name="note" Text="{Binding Note}" Style="{StaticResource Body}" FontSize="13.5" Foreground="{StaticResource Ash}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,1,0,0"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding LeftLit}" Value="True"><Setter TargetName="left" Property="Fill" Value="{StaticResource Gold}"/></DataTrigger>
                <DataTrigger Binding="{Binding RightLit}" Value="True"><Setter TargetName="right" Property="Fill" Value="{StaticResource Gold}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="done">
                    <Setter TargetName="gem" Property="Fill" Value="{StaticResource GoldGradient}"/>
                    <Setter TargetName="gem" Property="Stroke" Value="#A9843E"/>
                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource Parchment}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="active">
                    <Setter TargetName="gem" Property="Fill" Value="#241B0E"/>
                    <Setter TargetName="gem" Property="Stroke" Value="{StaticResource GoldBright}"/>
                    <Setter TargetName="gem" Property="StrokeThickness" Value="1.8"/>
                    <Setter TargetName="gem" Property="Effect"><Setter.Value><DropShadowEffect ShadowDepth="0" BlurRadius="14" Color="#F0D48A" Opacity="0.8"/></Setter.Value></Setter>
                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource Bone}"/>
                    <Setter TargetName="note" Property="Foreground" Value="{StaticResource GoldBright}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="PageScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="56,22,56,30"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageGlow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dev banner -->
        <Border Background="#3A1408" Padding="12,5" Visibility="{Binding IsDev, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding DevBanner}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#FF9C6E" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </Border>

        <!-- ============================== TOP BAR ============================== -->
        <Grid Grid.Row="1" Margin="44,16,44,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="Resources/wordmark.png" Height="44" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" ToolTip="LOTR MP Event"/>
            <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource TopRule}" Margin="22,0,40,0" VerticalAlignment="Center" MaxWidth="420" HorizontalAlignment="Left" Width="420"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource TopNav}" Content="PLAY" IsChecked="{Binding Page, Converter={StaticResource PageIs}, ConverterParameter=Home}"/>
                <RadioButton Style="{StaticResource TopNav}" Content="NEWS" IsChecked="{Binding Page, Converter={StaticResource PageIs}, ConverterParameter=News}"/>
                <RadioButton Style="{StaticResource TopNav}" Content="SETTINGS" IsChecked="{Binding Page, Converter={StaticResource PageIs}, ConverterParameter=Settings}"/>
                <RadioButton Style="{StaticResource TopNav}" Content="HELP" IsChecked="{Binding Page, Converter={StaticResource PageIs}, ConverterParameter=Support}"/>
            </StackPanel>
        </Grid>

        <!-- ============================== HOME (PLAY) ============================== -->
        <Grid Grid.Row="2" Margin="56,18,44,22" Visibility="{Binding Page, Converter={StaticResource Vis}, ConverterParameter=Home}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="262"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- left: what is going on, the road, and what to do next -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="#12C9A45C" BorderBrush="{StaticResource Gold}" BorderThickness="2,0,0,0" Padding="14,9" Margin="0,0,0,18"
                            Visibility="{Binding UpdaterUpdateReady, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding RestartToUpdateCommand}" Content="Restart now" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding CanRestartToUpdate, Converter={StaticResource Vis}}"/>
                            <TextBlock Text="{Binding UpdaterUpdateText}" Style="{StaticResource Body}" FontSize="14" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Eyebrow}" Text="{Binding HomeEyebrow}"/>
                    <TextBlock Text="{Binding HomeTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="44" Foreground="{StaticResource GoldGradient}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="52"/>
                    <TextBlock Text="{Binding HomeLede}" Style="{StaticResource Body}" FontSize="19" LineHeight="26" Foreground="{StaticResource Parchment}" Margin="0,10,0,0" MaxWidth="500" HorizontalAlignment="Left"
                               Visibility="{Binding HomeLede, Converter={StaticResource Vis}}"/>
                    <!-- server pause notice (battle night): where to get the mod meanwhile -->
                    <Button Command="{Binding OpenNoticeLinkCommand}" Content="{Binding NoticeLinkText}" Margin="0,16,0,0" Padding="20,10" HorizontalAlignment="Left"
                            Visibility="{Binding NoticeLinkText, Converter={StaticResource Vis}}"/>

                    <!-- error report (begin) -->
                    <StackPanel Visibility="{Binding StatusErrorDetail, Converter={StaticResource Vis}}" Margin="0,12,0,0">
                        <Button Style="{StaticResource LinkButton}" Command="{Binding ReportProblemCommand}" CommandParameter="check" Content="Send a report to the team" HorizontalAlignment="Left" FontSize="14"/>
                        <Expander Margin="0,6,0,0" Foreground="{StaticResource Dust}">
                            <Expander.Header><TextBlock Style="{StaticResource Muted}" Text="Details (for the team)"/></Expander.Header>
                            <TextBox Style="{StaticResource LogBox}" Text="{Binding StatusErrorDetail, Mode=OneWay}" MaxHeight="120" Margin="0,6,0,0"/>
                        </Expander>
                    </StackPanel>
                    <!-- error report (end) -->
                    <Button Command="{Binding AcceptRollbackCommand}" Content="Accept the rollback" Margin="0,14,0,0" Padding="20,10" HorizontalAlignment="Left"
                            Visibility="{Binding RollbackOffered, Converter={StaticResource Vis}}"/>

                    <!-- the road: download, verify, install, ready -->
                    <Grid Margin="-16,40,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="600"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
                        <ItemsControl ItemsSource="{Binding Stations}" ItemTemplate="{StaticResource StationTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>

                    <!-- ready: both modules must be ticked in the Bannerlord launcher; the app can do it on request -->
                    <WrapPanel Margin="0,26,0,0" Visibility="{Binding OfferTick, Converter={StaticResource Vis}}">
                        <Button Command="{Binding TickLauncherModsCommand}" Content="Tick them in the launcher for me" Padding="16,8" Margin="0,0,14,6"/>
                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="13" Margin="0,0,0,6" Text="Close the Bannerlord launcher first. You can undo it."/>
                    </WrapPanel>
                    <WrapPanel Margin="0,14,0,0" Visibility="{Binding HomeLauncherResult, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding HomeLauncherResult}" FontSize="14" TextWrapping="Wrap" MaxWidth="520">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                    <Setter Property="Foreground" Value="{StaticResource Dust}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LauncherStatusKind}" Value="ok"><Setter Property="Foreground" Value="{StaticResource Elven}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding LauncherStatusKind}" Value="warn"><Setter Property="Foreground" Value="#E89A5C"/></DataTrigger>
                                        <DataTrigger Binding="{Binding LauncherStatusKind}" Value="error"><Setter Property="Foreground" Value="{StaticResource Rubric}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Style="{StaticResource LinkButton}" Command="{Binding UndoLauncherModsCommand}" Content="Undo" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14"
                                Visibility="{Binding CanUndoLauncher, Converter={StaticResource Vis}}"/>
                    </WrapPanel>

                    <TextBlock Text="{Binding HomeWarning}" Style="{StaticResource Body}" Foreground="#E89A5C" FontSize="14" Margin="0,18,0,0" MaxWidth="520" HorizontalAlignment="Left"
                               Visibility="{Binding HomeWarning, Converter={StaticResource Vis}}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0" Visibility="{Binding WaitingLine, Converter={StaticResource Vis}}">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource GoldBright}" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.7"/></Storyboard></BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="{Binding BusyText}" Style="{StaticResource Muted}" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- bottom left: next event and the latest patch notes -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,40,0" ToolTip="{Binding NextBattle}">
                    <TextBlock Style="{StaticResource Eyebrow}" Text="NEXT EVENT"/>
                    <TextBlock Style="{StaticResource Body}" FontSize="18" Foreground="{StaticResource Bone}" Margin="0,4,0,0" TextWrapping="NoWrap">
                        <Run Text="in"/> <Run Text="{Binding Countdown, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding NextBattle}" Style="{StaticResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="300"/>
                    <TextBlock Style="{StaticResource Body}" FontSize="13" Foreground="#E89A5C" Visibility="{Binding BattleSoon, Converter={StaticResource Vis}}"
                               Text="Battle day: checks for updates every 20 minutes."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Visibility="{Binding NewsHeading, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource Eyebrow}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                        <Run Text="PATCH NOTES"/><Run Text=" · " Foreground="{StaticResource Ash}"/><Run Text="{Binding NewsVersion, Mode=OneWay}" Foreground="{StaticResource Ash}"/>
                    </TextBlock>
                    <DockPanel Margin="0,4,0,0" HorizontalAlignment="Left">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding NavigateCommand}" CommandParameter="News" Content="read more ›" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock Text="{Binding NewsTeaser}" Style="{StaticResource Body}" FontSize="18" Foreground="{StaticResource Bone}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </DockPanel>
                    <TextBlock Text="{Binding NewsNote}" Style="{StaticResource Muted}" FontSize="13" Visibility="{Binding NewsNote, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </Grid>

            <!-- right: the banner with both modules, and the round button (scaled down, never cut, in a short window) -->
            <Grid Grid.Column="2" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Viewbox StretchDirection="DownOnly" VerticalAlignment="Top">
            <StackPanel Width="262">
                <Border BorderBrush="{StaticResource Seam}" BorderThickness="1,0,1,0" Background="{StaticResource BannerFill}">
                    <StackPanel>
                        <Rectangle Height="3" Fill="{StaticResource BannerTop}"/>
                        <StackPanel x:Name="BannerBody" Margin="16,22,16,78">
                            <Image x:Name="BannerCrest" Source="Resources/crest.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="LOTR EVENT" FontFamily="{StaticResource DisplayFont}" FontSize="22" Foreground="{StaticResource Bone}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="{Binding BannerHeader}" FontFamily="{StaticResource DisplayFont}" FontSize="11" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,12"/>
                            <ItemsControl ItemsSource="{Binding BannerModules}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Seam}" BorderThickness="1" Background="#730A0806" Padding="10,8" Margin="0,0,0,6">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Pill}" Style="{StaticResource PillText}"/>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Bone}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Version}" Style="{StaticResource Body}" FontSize="14" Foreground="{StaticResource Parchment}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource SealButton}" Command="{Binding SealCommand}" Margin="0,-64,0,0" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding SealTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SealSub}" Style="{StaticResource Body}" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" Margin="0,1,0,0"
                                   Visibility="{Binding SealSub, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding SealCaption}" Style="{StaticResource Muted}" FontSize="13.5" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0" MaxWidth="250"
                           Visibility="{Binding SealCaption, Converter={StaticResource Vis}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Style="{StaticResource LinkButton}" Command="{Binding DetailsCommand}" Content="Show details" FontSize="14" Visibility="{Binding ShowDetailsLink, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="  ·  " Style="{StaticResource Muted}" Visibility="{Binding InstallingNow, Converter={StaticResource Vis}}"/>
                    <Button Style="{StaticResource LinkButton}" Command="{Binding CancelCommand}" Content="Cancel" FontSize="14" Foreground="{StaticResource Dust}" Visibility="{Binding InstallingNow, Converter={StaticResource Vis}}"/>
                    <Button Style="{StaticResource LinkButton}" Command="{Binding CheckCommand}" Content="Check again" FontSize="14" Visibility="{Binding CanCheckAgain, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </StackPanel>
                </Viewbox>

            <!-- bottom right: last check and file check -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,0,0">
                <Button Style="{StaticResource LinkButton}" Command="{Binding CheckCommand}" FontFamily="{StaticResource DisplayFont}" FontSize="11.5" Foreground="{StaticResource Ash}" ToolTip="{Binding LastCheck}" Content="CHECK FOR UPDATES" Margin="0,0,18,0"/>
                <Button Style="{StaticResource LinkButton}" Command="{Binding NavigateCommand}" CommandParameter="Verify" FontFamily="{StaticResource DisplayFont}" FontSize="11.5" Foreground="{StaticResource Ash}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M6,0 L12,2.2 L12,6.5 C12,10 9.4,12.6 6,14 C2.6,12.6 0,10 0,6.5 L0,2.2 Z M3.4,7 L5.4,9 L8.8,5.2" Stroke="{StaticResource Ash}" StrokeThickness="1.1" Width="12" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="VERIFY FILES" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            </Grid>
        </Grid>

        <!-- ============================== NEWS ============================== -->
        <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}" Visibility="{Binding Page, Converter={StaticResource Vis}, ConverterParameter=News}">
            <StackPanel Width="720" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Kicker}" Text="PATCH NOTES"/>
                <TextBlock Style="{StaticResource Title}" Text="{Binding NewsHeading}" Visibility="{Binding NewsHeading, Converter={StaticResource Vis}}"/>
                <TextBlock Style="{StaticResource Title}" Text="No notes yet" Visibility="{Binding NewsHeading, Converter={StaticResource NotVis}}"/>
                <TextBlock Text="{Binding NewsNote}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,6" Visibility="{Binding NewsNote, Converter={StaticResource Vis}}"/>
                <Border Style="{StaticResource Card}" Margin="0,12,0,14" Visibility="{Binding NewsHeading, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding NewsBody}" Style="{StaticResource Body}" FontSize="15" LineHeight="22" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Style="{StaticResource Muted}" FontSize="12.5" Visibility="{Binding NewsSignatureText, Converter={StaticResource Vis}}"><Run Text="✓ " Foreground="{StaticResource Elven}"/><Run Text="{Binding NewsSignatureText, Mode=OneWay}"/></TextBlock>
                <TextBlock Style="{StaticResource Muted}" FontSize="12.5" Text="{Binding NewsSource}" Visibility="{Binding NewsSource, Converter={StaticResource Vis}}"/>
                <StackPanel Visibility="{Binding PreviousNews.Count, Converter={StaticResource Vis}}" Margin="0,22,0,0">
                    <TextBlock Style="{StaticResource H2}" Text="EARLIER RELEASES"/>
                    <ItemsControl ItemsSource="{Binding PreviousNews}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Style="{StaticResource Body}" FontSize="15">
                                        <Run Text="{Binding Title, Mode=OneWay}" Foreground="{StaticResource Bone}"/>
                                        <Run Text="·" Foreground="{StaticResource Dust}"/>
                                        <Run Text="{Binding DateLabel, Mode=OneWay}" Foreground="{StaticResource Dust}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Notes}" Style="{StaticResource Body}" FontSize="14" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Button Style="{StaticResource LinkButton}" Command="{Binding OpenNewsCommand}" Content="All the news on the website ›" FontSize="14" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Visibility="{Binding ChroniclesUrl, Converter={StaticResource Vis}}" ToolTip="{Binding ChroniclesUrl}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================== PLAN ============================== -->
        <Grid Grid.Row="2" Visibility="{Binding Page, Converter={StaticResource Vis}, ConverterParameter=Plan}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer Style="{StaticResource PageScroll}">
                <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Kicker}" Text="UPDATE PLAN · NOTHING HAPPENS BEFORE YOU CLICK"/>
                    <TextBlock Style="{StaticResource Title}" Text="{Binding PlanTitle}" Visibility="{Binding HasPlan, Converter={StaticResource Vis}}"/>
                    <TextBlock Style="{StaticResource Title}" Text="No plan yet" Visibility="{Binding HasPlan, Converter={StaticResource NotVis}}"/>
                    <TextBlock Style="{StaticResource Lead}" Text="Click Show details under Update (or Repair on Verify files): the exact list of changes appears here first." Visibility="{Binding HasPlan, Converter={StaticResource NotVis}}"/>
                    <TextBlock Style="{StaticResource Lead}" Text="{Binding PlanNote}" Visibility="{Binding HasPlan, Converter={StaticResource Vis}}" Margin="0,0,0,18"/>

                    <ItemsControl ItemsSource="{Binding PlanIssues}" ItemTemplate="{StaticResource IssueTemplate}" Margin="0,0,0,10"/>

                    <Border Style="{StaticResource Card}" Visibility="{Binding HasPlan, Converter={StaticResource Vis}}">
                        <ItemsControl ItemsSource="{Binding PlanFacts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource DisplayFont}" FontSize="12" Foreground="{StaticResource Gold}" Margin="0,2,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Body}" FontSize="13.5"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <ItemsControl ItemsSource="{Binding PlanModules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="16" Foreground="{StaticResource GoldBright}"/>
                                        <TextBlock Text="{Binding Folder}" Style="{StaticResource Mono}" Margin="0,3,0,2"/>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}"/>
                                        <Expander IsExpanded="{Binding Expanded, Mode=OneTime}" Margin="0,8,0,0" Foreground="{StaticResource Gold}" Visibility="{Binding Files, Converter={StaticResource Vis}}">
                                            <Expander.Header>
                                                <TextBlock Text="Show every file" Style="{StaticResource Body}" FontSize="13" Foreground="{StaticResource Gold}"/>
                                            </Expander.Header>
                                            <ListBox ItemsSource="{Binding Files}" MaxHeight="260" Background="{StaticResource Pitch}" BorderBrush="{StaticResource Iron}" Margin="0,6,0,0"
                                                     VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="8,2"/>
                                                        <Setter Property="Focusable" Value="False"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel>
                                                            <TextBlock x:Name="k" Text="{Binding Kind}" Width="64" Style="{StaticResource Mono}" Foreground="{StaticResource Elven}"/>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Style="{StaticResource Mono}" Margin="10,0,0,0"/>
                                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" Foreground="{StaticResource Parchment}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        </DockPanel>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="replace"><Setter TargetName="k" Property="Foreground" Value="{StaticResource GoldBright}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="remove"><Setter TargetName="k" Property="Foreground" Value="{StaticResource Rubric}"/></DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Background="{StaticResource Pitch}" BorderBrush="{StaticResource Iron}" BorderThickness="0,1,0,0" Padding="56,14" Visibility="{Binding HasPlan, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" Content="Install now"/>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Home" Content="Back" Margin="12,0,0,0"/>
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="12" Text="Close Bannerlord and its launcher first."/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================== PROGRESS ============================== -->
        <Grid Grid.Row="2" Margin="56,22,56,24" Visibility="{Binding Page, Converter={StaticResource Vis}, ConverterParameter=Progress}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
                <TextBlock Style="{StaticResource Kicker}" Text="PROGRESS"/>
                <TextBlock Style="{StaticResource Title}" Text="{Binding ProgressTitle}"/>
                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="1" Margin="0,12,0,8"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding CancelCommand}" Content="Cancel" Visibility="{Binding Busy, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
            <Border Grid.Row="1" x:Name="resultBox" Padding="14,10" Margin="0,14,0,0" BorderThickness="2,0,0,0"
                    Visibility="{Binding ProgressResult, Converter={StaticResource Vis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource Elven}"/>
                        <Setter Property="Background" Value="#149CC28A"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProgressResultKind}" Value="error"><Setter Property="BorderBrush" Value="{StaticResource Rubric}"/><Setter Property="Background" Value="#1AE0563A"/></DataTrigger>
                            <DataTrigger Binding="{Binding ProgressResultKind}" Value="warn"><Setter Property="BorderBrush" Value="{StaticResource Ember}"/><Setter Property="Background" Value="#14B3471D"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding ProgressResult}" Style="{StaticResource Body}"/>
                    <!-- error report (begin) -->
                    <StackPanel Visibility="{Binding ProgressResultKind, Converter={StaticResource Vis}, ConverterParameter=error}" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ReportProblemCommand}" CommandParameter="install" Content="Send a report to the team"/>
                            <Button Command="{Binding InstallCommand}" Content="Try again" Margin="12,0,0,0" Padding="20,12"/>
                        </StackPanel>
                        <Expander Margin="0,10,0,0" Foreground="{StaticResource Dust}" Visibility="{Binding ProgressErrorDetail, Converter={StaticResource Vis}}">
                            <Expander.Header><TextBlock Style="{StaticResource Muted}" Text="Details (for the team)"/></Expander.Header>
                            <TextBox Style="{StaticResource LogBox}" Text="{Binding ProgressErrorDetail, Mode=OneWay}" MaxHeight="140" Margin="0,6,0,0"/>
                        </Expander>
                    </StackPanel>
                    <!-- error report (end) -->
                </StackPanel>
            </Border>
            <DockPanel Grid.Row="2" Margin="0,18,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding OpenLogsCommand}" Content="Open the logs folder"/>
                    <TextBlock Style="{StaticResource H2}" Text="LIVE LOG" Margin="0"/>
                </DockPanel>
                <TextBox x:Name="LiveLog" Style="{StaticResource LogBox}" Text="{Binding LogText, Mode=OneWay}"/>
            </DockPanel>
        </Grid>

        <!-- ============================== VERIFY ============================== -->
        <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}" Visibility="{Binding Page, Converter={StaticResource Vis}, ConverterParameter=Verify}">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Kicker}" Text="VERIFY MY INSTALL"/>
                <TextBlock Style="{StaticResource Title}" Text="Is everything in order?"/>
                <TextBlock Style="{StaticResource Lead}" Text="{Binding VerifySummary}" Margin="0,0,0,18"/>
                <!-- error report (begin) -->
                <StackPanel Visibility="{Binding VerifyKind, Converter={StaticResource Vis}, ConverterParameter=error}" Margin="0,-8,0,18">
                    <Button Style="{StaticResource LinkButton}" Command="{Binding ReportProblemCommand}" CommandParameter="verify" Content="Send a report to the team" HorizontalAlignment="Left"/>
                    <Expander Margin="0,6,0,0" Foreground="{StaticResource Dust}" Visibility="{Binding VerifyErrorDetail, Converter={StaticResource Vis}}">
                        <Expander.Header><TextBlock Style="{StaticResource Muted}" Text="Details (for the team)"/></Expander.Header>
                        <TextBox Style="{StaticResource LogBox}" Text="{Binding VerifyErrorDetail, Mode=OneWay}" MaxHeight="120" Margin="0,6,0,0"/>
                    </Expander>
                </StackPanel>
                <!-- error report (end) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding VerifyCommand}" Content="Verify now"/>
                    <Button Command="{Binding RepairCommand}" Content="Repair…" Margin="12,0,0,0" Padding="20,12"/>
                    <Button Style="{StaticResource LinkButton}" Command="{Binding OpenModulesCommand}" Content="Open the Modules folder" Margin="18,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding VerifyRows}" ItemTemplate="{StaticResource IssueTemplate}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================== SUPPORT ============================== -->
        <Grid Grid.Row="2" Margin="56,22,56,24" Visibility="{Binding Page, Converter={StaticResource Vis}, ConverterParameter=Support}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Kicker}" Text="HELP"/>
                <TextBlock Style="{StaticResource Title}" Text="Something is wrong? Send us your log"/>
                <!-- error report (begin) -->
                <Border Background="#1AE0563A" BorderBrush="{StaticResource Rubric}" BorderThickness="2,0,0,0" Padding="12,8" Margin="0,0,0,12" Visibility="{Binding SupportContext, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding SupportContext}" Style="{StaticResource Body}" FontSize="13"/>
                </Border>
                <!-- error report (end) -->
                <TextBlock Style="{StaticResource Lead}" Margin="0,0,0,14"
                           Text="Below is exactly what would be sent — your Windows user name is replaced by &lt;user&gt;. Nothing is sent unless you press the button. You get a short code: paste it in your ticket on the LotR Discord, the team's bot attaches the log there."/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SendSupportCommand}" Content="Send the report"/>
                    <Button Command="{Binding CopyLogCommand}" Content="Copy log" Margin="12,0,0,0" Padding="20,12"/>
                    <Button Style="{StaticResource LinkButton}" Command="{Binding RefreshLogCommand}" Content="Refresh" Margin="18,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <Border Background="#17C9A45C" BorderBrush="{StaticResource Gold}" BorderThickness="1" Padding="18,12" Visibility="{Binding SupportCode, Converter={StaticResource Vis}}" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="Your support code" FontSize="12"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding CopySupportCodeCommand}" Content="Copy" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SupportCode, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource DisplayFont}" FontSize="28" Foreground="{StaticResource GoldBright}" Background="Transparent" BorderThickness="0" Padding="0"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Body}" FontSize="13" Text="On the LotR Discord: open a ticket, then type /support code: followed by this code. The log is deleted after the team reads it."/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding SupportStatus}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding SupportStatus, Converter={StaticResource Vis}}"/>
            </StackPanel>
            <TextBox Grid.Row="2" Style="{StaticResource LogBox}" Text="{Binding SupportLog, Mode=OneWay}" Margin="0,14,0,0"/>
        </Grid>

        <!-- ============================== SETTINGS ============================== -->
        <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}" Visibility="{Binding Page, Converter={StaticResource Vis}, ConverterParameter=Settings}">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Kicker}" Text="SETTINGS"/>
                <TextBlock Style="{StaticResource Title}" Text="Your preferences" Margin="0,0,0,18"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="YOUR GAME"/>
                        <TextBlock Text="{Binding GameTitle}" Style="{StaticResource Body}" FontSize="16" Foreground="{StaticResource Bone}"/>
                        <TextBlock Text="{Binding GameStore}" Style="{StaticResource Muted}" Foreground="{StaticResource Gold}" Margin="0,2,0,6" Visibility="{Binding GameStore, Converter={StaticResource Vis}}"/>
                        <TextBlock Text="{Binding GamePathSetting}" Style="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Parchment}"/>
                        <TextBlock Text="{Binding GameNote}" Style="{StaticResource Body}" Foreground="#E89A5C" FontSize="13" Margin="0,8,0,0" Visibility="{Binding GameNote, Converter={StaticResource Vis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Command="{Binding BrowseGameCommand}" Content="Choose another folder…"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SettingsMessage}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding SettingsMessage, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Several copies of the game? Pick the one you start for the event (Steam, Epic, GOG or the Xbox app)."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="RELEASE CHANNEL"/>
                        <RadioButton GroupName="ch" IsChecked="{Binding IsStable}" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Body}"><Run Text="Stable" Foreground="{StaticResource Bone}"/><Run Text=" — what the event server runs. Recommended." Foreground="{StaticResource Dust}"/></TextBlock>
                        </RadioButton>
                        <RadioButton GroupName="ch" IsChecked="{Binding IsBeta}">
                            <TextBlock Style="{StaticResource Body}"><Run Text="Beta" Foreground="{StaticResource Bone}"/><Run Text=" — test builds for testers; may not match the event server." Foreground="{StaticResource Dust}"/></TextBlock>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="BACKGROUND DOWNLOAD"/>
                        <CheckBox IsChecked="{Binding PreDownload}">
                            <TextBlock Style="{StaticResource Body}" Text="Download new releases in advance while this app is open (after a random delay of up to 6 hours, so that not everyone downloads at once). Installing still waits for your click."/>
                        </CheckBox>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="START WITH WINDOWS"/>
                        <CheckBox IsChecked="{Binding StartWithWindows}">
                            <TextBlock Style="{StaticResource Body}" Text="Start this app with Windows, minimised to the notification area, so new releases are downloaded in advance even when you have not opened it. A notification tells you when an update is ready; installing still waits for your click. Off by default."/>
                        </CheckBox>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap">
                            <Run Text="How: one shortcut in your own Startup folder ("/><Run Text="{Binding StartupShortcutPath, Mode=OneWay}"/><Run Text="). No registry Run key, no scheduled task, no service. Untick here, delete that shortcut, or turn it off in Task Manager › Startup apps. While it is on, closing the window keeps the app in the notification area (right-click › Exit to quit)."/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="BANNERLORD LAUNCHER"/>
                        <StackPanel Visibility="{Binding ShowLauncherCard, Converter={StaticResource Vis}}" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding TickLauncherModsCommand}" Content="Tick the mods in the Bannerlord launcher for me"/>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding UndoLauncherModsCommand}" Content="Undo" VerticalAlignment="Center" Margin="14,0,0,0"
                                        Visibility="{Binding CanUndoLauncher, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12.5" TextWrapping="Wrap" ToolTip="{Binding LauncherFilePath}"
                                       Text="Changes only the launcher's Multiplayer mod list (nothing else), and only when you press the button. A copy of the previous list is kept next to it. Close the launcher first."/>
                            <TextBlock Text="{Binding LauncherStatus}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding LauncherStatus, Converter={StaticResource Vis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LauncherStatusKind}" Value="ok"><Setter Property="Foreground" Value="{StaticResource Elven}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding LauncherStatusKind}" Value="warn"><Setter Property="Foreground" Value="#E89A5C"/></DataTrigger>
                                            <DataTrigger Binding="{Binding LauncherStatusKind}" Value="error"><Setter Property="Foreground" Value="{StaticResource Rubric}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding AutoTickLauncherMods}">
                            <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="Tick the mods automatically after each update. The app then ticks LotRMPCore and LotRMPEvent in the launcher's Multiplayer list after every successful update, keeps a copy of the previous list and lets you undo it on Play or here. Off by default; it never runs while the launcher or the game is open."/>
                        </CheckBox>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="BACKUP AND REMOVAL"/>
                        <TextBlock Style="{StaticResource Body}" Text="Files replaced by the last update are kept until the next one." Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding OpenBackupCommand}" Content="Open the backup folder"/>
                            <Button Command="{Binding UninstallCommand}" Content="Uninstall this app…" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="ABOUT THIS APP"/>
                        <TextBlock Style="{StaticResource Body}">
                            <Run Text="Version"/> <Run Text="{Binding AppVersion, Mode=OneWay}"/><Run Text=" · no admin rights · no service · no telemetry · signed releases" Foreground="{StaticResource Dust}"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="About" Content="What this app does"/>
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Verify" Content="Verify files" Margin="12,0,0,0"/>
                            <Button Style="{StaticResource LinkButton}" Command="{Binding OpenLogsCommand}" Content="Open the logs folder" VerticalAlignment="Center" Margin="18,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================== ABOUT ============================== -->
        <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}" Visibility="{Binding Page, Converter={StaticResource Vis}, ConverterParameter=About}">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Kicker}" Text="TRANSPARENCY"/>
                <TextBlock Style="{StaticResource Title}" Text="What this app does — and does not"/>
                <TextBlock Style="{StaticResource Lead}" Margin="0,0,0,18"
                           Text="It keeps the LotR MP Event mod files identical to the release the team signed. It needs no administrator rights, installs no service, runs only while its window (or, if you chose &quot;Start with Windows&quot;, its notification-area icon) is open, and sends no telemetry."/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="FOLDERS IT TOUCHES"/>
                        <ItemsControl ItemsSource="{Binding Folders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource DisplayFont}" FontSize="12" Foreground="{StaticResource Gold}" Margin="0,2,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Body}" FontSize="13.5"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="It changes the launcher's mod list only if you ask: the &quot;Tick them in the launcher for me&quot; button on Play or in Settings, or the option in Settings (off by default). Then only the Multiplayer list is touched, a dated copy of the previous file is kept next to it, and Undo puts it back. Otherwise you tick the modules yourself. It never writes outside the places above."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="EVERY NETWORK ADDRESS IT CAN CALL"/>
                        <ItemsControl ItemsSource="{Binding Endpoints}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Mono}" Margin="0,2"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Requests carry only the app name and version (User-Agent). The download queue and the support code use a random install id, nothing else."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="HOW YOU KNOW THE FILES ARE GENUINE"/>
                        <TextBlock Style="{StaticResource Body}" Text="Each release's file list is signed by the team (ECDSA P-256). Every file is checked against its SHA-256 before it is installed. Trusted key fingerprint(s) — compare with the Security page of the website:"/>
                        <ItemsControl ItemsSource="{Binding Fingerprints}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Mono}" Foreground="{StaticResource GoldBright}" Margin="0,2"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Scans}" ItemTemplate="{StaticResource IssueTemplate}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="UPDATES OF THIS APP"/>
                        <TextBlock Style="{StaticResource Body}" Text="The app reads files/updater/latest.json on the same server. A newer version is downloaded next to it, checked (its SHA-256, the team's signature of latest.json, and — once the app is code-signed — that the new exe is signed by the same publisher), and only replaces this one the next time the app starts. The previous version is kept so you can go back."/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding PreviousUpdaterVersion, Converter={StaticResource Vis}}">
                            <Button Command="{Binding RollbackUpdaterCommand}" Content="Go back to the previous version"/>
                            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"><Run Text="kept: "/><Run Text="{Binding PreviousUpdaterVersion, Mode=OneWay}"/></TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="LICENCE AND VERSION"/>
                        <TextBlock Style="{StaticResource Body}">
                            <Run Text="LotRMPUpdater"/> <Run Text="{Binding AppVersion, Mode=OneWay}"/><Run Text=" · made by the LotR MP Event team for its players · source available on request from the team."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Includes ZstdSharp (MIT licence, © Oleg Stepanischev). Mount &amp; Blade II: Bannerlord is a trademark of TaleWorlds Entertainment; this is a fan project, not affiliated with TaleWorlds."/>
                        <Expander Margin="0,10,0,0" Foreground="{StaticResource Dust}">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource Muted}" Text="Fonts: Cinzel (© The Cinzel Project Authors) and Cormorant Garamond (© The Cormorant Project Authors), SIL Open Font License 1.1 — show the licence"/>
                            </Expander.Header>
                            <TextBox Style="{StaticResource LogBox}" Text="{Binding FontLicences, Mode=OneWay}" Height="220" Margin="0,8,0,0"/>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
