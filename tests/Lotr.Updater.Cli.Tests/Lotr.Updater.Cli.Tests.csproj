<Project Sdk="Microsoft.NET.Sdk">
  <!-- lotr-updater (src/Lotr.Updater.Cli) end to end: the real command line against a local fake release (TestHttpServer)
       and a fake game in a temp folder. Never the real game, never a real server. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Lotr.Updater.Cli.Tests</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Lotr.Updater.Cli\Lotr.Updater.Cli.csproj" />
    <Compile Include="..\Lotr.Updater.Tests\Support\ReleaseBuilder.cs" Link="Support\ReleaseBuilder.cs" />
    <Compile Include="..\Lotr.Updater.Tests\Support\TestHttpServer.cs" Link="Support\TestHttpServer.cs" />
  </ItemGroup>
</Project>
